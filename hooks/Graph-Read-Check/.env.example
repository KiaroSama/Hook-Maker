# Graph-Read-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Policy note on SessionStart;
# task-relevance reminder on UserPromptSubmit (silent unless the prompt
# suggests codebase-structure understanding is needed).
EVENTS=SessionStart,UserPromptSubmit

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex, Kiro,
# or All. Legacy: Both = Claude + Codex only.
CLIENTS=Both

# Where Codebase Memory MCP keeps its per-project databases. Read because this
# hook stays SILENT when the project already has a CBM index - that graph is
# primary, and two hooks pointing at two different graphs is noise. Blank means
# the CBM_CACHE_DIR environment variable, then the binary's own default.
CBM_CACHE_DIR=
