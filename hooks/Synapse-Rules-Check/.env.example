# Synapse-Rules-Check - optional configuration. Copy to `.env` beside the
# installed hook to override; every value below is the default.

# Where Synapse is installed. Only used as a FALLBACK relevance signal when the
# store itself is not at the default location: the hook stays completely silent
# on a machine with no Synapse, and this is how it recognises a non-default
# layout. The store checked first is always %USERPROFILE%\.synapse\synapse.db.
SYNAPSE_HOME=
