# Cross-Project-.ai-Knowledge-Sync (sync engine) configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.
#
# The engine itself is configured by sync-hooks.json at the tool root; this file
# only feeds the Hook Maker menu so a sync group can be created WITHOUT typing
# the project paths each time (menu option 1 offers to use these).

# Project roots of the sync group (semicolon separated, at least 2).
# Example: SYNC_PROJECTS=G:\Projects\Bot A;G:\Projects\Bot B;G:\Projects\Bot C
SYNC_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Both, Claude, or Codex.
CLIENTS=Both
