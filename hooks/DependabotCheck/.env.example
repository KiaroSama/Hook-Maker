# DependabotCheck configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Runs before work starts.
EVENTS=SessionStart

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Minimum minutes before repeating an UNCHANGED Dependabot finding per repo.
# A changed PR set (new PR, new commit, new check state) reports immediately.
COOLDOWN_MINUTES=120

# Maximum pull requests detailed in the injected note.
PR_LIMIT=5
