# Cbm-Read-Check - optional configuration. Copy to `.env` beside the installed
# hook to override; the value below is the default.

# Where Codebase Memory MCP keeps its per-project databases. Blank means: use
# the CBM_CACHE_DIR environment variable, and if that is unset too, the
# binary's own default (%USERPROFILE%\.cache\codebase-memory-mcp).
# The hook is completely silent when <cache>\_config.db does not exist.
CBM_CACHE_DIR=
