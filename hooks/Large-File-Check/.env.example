# Large-File-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.
#
# Two stages, one shared threshold:
#   SessionStart / UserPromptSubmit = the pre-task hard-ceiling policy (uses the
#     effective LINE_THRESHOLD below). SessionStart also records a metadata-only
#     baseline - relative path + line count per source file, never contents - in
#     %LOCALAPPDATA%\HookMaker\state, never in the project.
#   Stop = post-task scan reporting source files STRICTLY above LINE_THRESHOLD.
#     Advisory for files that were already over it, and ONE gate: a file the task
#     itself pushed past the ceiling (at or under it in the baseline, over it now)
#     blocks once per fingerprint, with the recovery that clears it.
# The hook never splits a file and never blocks a push.

# Events to register on (comma separated).
EVENTS=SessionStart,Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Lines above which a source file is reported after a task (STRICT greater-than:
# with the default 800, a 801-line file is reported and an exactly-800-line file
# is not). A value that is missing, malformed, zero/negative, below 50, or above
# 100000 falls back to 800. The same effective value drives the pre-task guidance.
LINE_THRESHOLD=800

# Source extensions to scan (comma separated). Blank/all-invalid falls back to
# the built-in list below.
EXTENSIONS=.ps1,.psm1,.py,.js,.ts,.jsx,.tsx,.mjs,.cjs,.cs,.java,.go,.rb,.php,.rs,.c,.cpp,.h,.kt,.swift,.vue,.svelte

# Minimum minutes between Stop reports per project (0..100000; default 60).
COOLDOWN_MINUTES=60

# Source-file scan ceiling (1..1000000; default 5000). When the ceiling is
# reached the Stop report says the scan was PARTIAL - it never implies it covered
# the whole repository.
MAX_FILES=5000

# Directory-traversal ceiling (1..1000000; default 4000). MAX_FILES bounds only
# source files, so a huge asset/non-source tree could still make the walk run
# long; this caps how many directories the scan may traverse. Reaching it marks
# the Stop report PARTIAL and names "directories". Invalid/out-of-range -> 4000.
MAX_DIRECTORIES=4000

# Total traversal wall-time ceiling in seconds (1..3600; default 5). Caps how long
# the whole scan may run regardless of file/dir counts. Reaching it marks the Stop
# report PARTIAL and names "time". Invalid/out-of-range -> 5.
MAX_SCAN_SECONDS=5
