# Test-Run-Guard - during-the-work gate for unbounded test commands.
#
# Copy to .env next to this file and edit. An invalid value is reported once, in
# plain text, and the default is used: a malformed setting must never turn this
# gate into an unconditional blocker, and must never silently disable it either.
#
# These values are handed to scripts\Run-Tests-Guarded.ps1, which owns the live
# child process. The hook itself returns in milliseconds and monitors nothing.

# Total wall ceiling for one guarded test run, in seconds. A CEILING, not an
# expected duration - pick it from measured normal behaviour plus margin.
# The full local matrix in this repository takes ~11 minutes, so 1800 leaves
# generous room without letting a genuine hang run all day.
# Default: 1800
TEST_GUARD_WALL_TIMEOUT_SECONDS=1800

# No output and no state change for this long counts as "no progress". This
# alone never kills anything - see the runner's Test-ShouldTerminate.
# Default: 300
TEST_GUARD_IDLE_TIMEOUT_SECONDS=300

# Sampling interval for heartbeat, CPU and memory, in seconds.
# Default: 10
TEST_GUARD_HEARTBEAT_SECONDS=10

# Resident memory ceiling for the whole owned process tree, in MB.
# 0 DISABLES it, which is the default on purpose: there is no universal correct
# value, and a wrong one kills valid work on a large suite.
# Default: 0
TEST_GUARD_MAX_MEMORY_MB=0

# Upper bound on test workers this project may use. Empty means "use the shared
# resource-aware budget" (max(2, min(8, cores-2))), which leaves headroom for
# the OS and prevents agents, CI and suites from each claiming every core.
# NOTE: the guarded runner takes no worker argument, so this is surfaced as
# guidance in the block message rather than passed through. Documented as a
# known limitation rather than silently dropped.
# Default: empty
TEST_GUARD_MAX_WORKERS=

# Comma-separated extra command fragments that identify a TEST command in this
# project, on top of the built-in conservative set. Recognition is structured
# and deliberately narrow; anything not recognised is left completely alone.
# Example: pytest,vitest,gradle test
# Default: empty
TEST_GUARD_EXTRA_TEST_COMMANDS=

# Comma-separated fragments that must NEVER be treated as a test command even
# if they look like one. Takes precedence over recognition.
# Default: empty
TEST_GUARD_NEVER_GUARD=

# Set to 1 to advise instead of blocking on PreToolUse. The finding is still
# reported; the command is allowed through.
# Default: 0
TEST_GUARD_ADVISORY_ONLY=0
