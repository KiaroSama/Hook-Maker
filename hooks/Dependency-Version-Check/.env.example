# Dependency-Version-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). SessionStart reports version-freshness
# findings; UserPromptSubmit reuses the cached findings and adds "prefer latest
# stable" guidance when the prompt looks like it is adding a dependency/
# framework/runtime/build tool/action/Docker image; Stop/SubagentStop replay the
# still-unanswered findings once per session (cached only - no scan, no block).
EVENTS=SessionStart,UserPromptSubmit,Stop,SubagentStop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex, Kiro,
# or All. Legacy: Both = Claude + Codex only.
CLIENTS=Both

# Minutes between full scans while the detected ecosystems/manifests/lockfiles/
# workflows/Dockerfiles are unchanged (a changed fingerprint always re-scans
# immediately regardless of this cooldown). Default is a week - this is a
# heavier scan than the other pre-task hooks, not a per-session one.
COOLDOWN_MINUTES=10080

# Maximum findings included in one report (advisory - avoids overwhelming
# context with every transitive dependency).
MAX_FINDINGS=12

# 1 (default) replays the still-unanswered findings once at Stop/SubagentStop,
# so a report delivered at the start of a long session cannot simply scroll out
# of context unanswered. 0 keeps the hook pre-task only. The closing half reads
# the cached report only - it never scans, never upgrades, and never blocks.
CLOSING_REMINDER=1
