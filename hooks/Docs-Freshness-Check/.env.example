# Docs-Freshness-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). SessionStart records a silent
# baseline; Stop evaluates the task delta and requests a mandatory
# acknowledgement when tracked documentation may now be stale.
EVENTS=SessionStart,Stop

# Which client(s) to install for from the Hook Maker menu: Claude, Codex, Kiro,
# or All. Legacy: Both = Claude + Codex only.
CLIENTS=Both

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# File extensions treated as reviewable documentation (comma separated).
DOC_EXTENSIONS=.md,.txt

# Bounds - detection stops and reports conservatively once reached.
MAX_CHANGED_FILES=100
MAX_DOC_FILES=200
MAX_FINDINGS=20

# Master switch for the mandatory Stop block. When false, the hook still
# detects and can be queried, but never blocks completion.
REQUIRE_ACKNOWLEDGEMENT=true

# Extra relative-path wildcard patterns (semicolon separated). INCLUDE forces
# an otherwise-excluded path back into scope; EXCLUDE adds another exclusion.
# Neither can override the hard exclusions (.git/.ai/.claude/.codex/.agents/
# .cross-project-sync, secrets.md, generated/vendor/build/cache directories,
# fixture/snapshot/golden files, LICENSE*/NOTICE*/COPYING*).
EXTRA_INCLUDE_PATTERNS=
EXTRA_EXCLUDE_PATTERNS=
