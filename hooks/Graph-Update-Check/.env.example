# Graph-Update-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Runs after each task.
# Advisory only; healthy rollback stays until verified success, then exact
# proven owned obsolete copies are permanently deleted. This hook deletes nothing.
EVENTS=Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Minimum minutes between reminders per project.
# Accepted range 0-10080; anything else keeps the default.
COOLDOWN_MINUTES=60

# Both graphs remain required; CMM does not suppress Graphify reminders.
