# Test-Completion-Check - after-the-work evidence and cleanup gate.
#
# Copy to .env next to this file and edit. An invalid value is reported once, in
# plain text, and the default is used. This hook blocks completion, so a
# malformed setting must never WIDEN what it blocks on - where the safe
# direction is to report rather than block, the fallback goes that way even
# when it differs from the documented default.

# Minutes a guarded-run result stays "current" for the same project state.
# Older evidence is treated as stale rather than as proof a run happened.
# Default: 180
TEST_COMPLETION_EVIDENCE_MINUTES=180

# Set to 1 to report findings without blocking completion. The findings are
# still surfaced; the Stop is allowed through.
# An INVALID value falls back to 1 (advisory), not to 0: falling back to the
# blocking default would widen what a malformed setting blocks on.
# Default: 0
TEST_COMPLETION_ADVISORY_ONLY=0

# Set to 1 to require a durable .ai/ note after ANY guarded run, not only after
# a hang, timeout, kill, or unexpectedly slow run.
# Default: 0
TEST_COMPLETION_ALWAYS_REQUIRE_NOTE=0

# Seconds to wait for a same-Stop race with Test-Temp-Cleanup before deferring
# to the next event. Never a retry loop - it defers once and stays silent.
# Capped at 30; a value above ~15 would need the hook's own timeout raised.
# Default: 2
TEST_COMPLETION_COORDINATION_WAIT_SECONDS=2

# Hours an ACTIVE guarded-run record whose owner process is gone, and which never
# produced a result document, can still describe the current work. Past this it is
# an earlier session's leftover: it is reconciled into this hook's ledger (never
# silently deleted) and dropped, so one abandoned run can no longer block every
# future Stop. A record inside the horizon still BLOCKS - a run that died without
# recording how it ended is a finding, not an absence of one.
# Default: 12
TEST_COMPLETION_ACTIVE_MARKER_MAX_HOURS=12

# Image-name patterns (comma-separated, wildcards allowed, case-insensitive)
# for the ADVISORY list of possible orphaned test processes at Stop: a matching
# process that started AFTER this session's SessionStart baseline is named, with
# its pid, start time and the first 120 characters of its command line, so the
# survivor sweep (global-test-rules.md -> No Orphaned Test Processes) can check
# it. Advisory only - the hook cannot prove ownership, so it never blocks and
# never terminates anything; at most 10 rows are printed and the remainder are
# reported as a count. This hook's own process and its ancestors (the agent's
# shell and client) are always excluded. An EMPTY value switches the advisory
# off; more than 64 patterns is reported and truncated.
# Default: node*,python*,pytest*,jest*,vitest*,mocha*,pwsh*,powershell*,dotnet*,java*,ruby*,php*,deno*,bun*,cargo*,chrome*,chromium*,msedge*,firefox*,chromedriver*,geckodriver*,playwright*,uvicorn*,gunicorn*,vite*,webpack*
TEST_COMPLETION_SURVIVOR_PATTERNS=node*,python*,pytest*,jest*,vitest*,mocha*,pwsh*,powershell*,dotnet*,java*,ruby*,php*,deno*,bun*,cargo*,chrome*,chromium*,msedge*,firefox*,chromedriver*,geckodriver*,playwright*,uvicorn*,gunicorn*,vite*,webpack*
