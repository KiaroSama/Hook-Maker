# Test-Completion-Check - after-the-work evidence and cleanup gate.
#
# Copy to .env next to this file and edit. An invalid value is reported once, in
# plain text, and the default is used. This hook blocks completion, so a
# malformed setting must never WIDEN what it blocks on - where the safe
# direction is to report rather than block, the fallback goes that way even
# when it differs from the documented default.

# Minutes a guarded-run result stays "current" for the same project state.
# Older evidence is treated as stale rather than as proof a run happened.
# Default: 180
TEST_COMPLETION_EVIDENCE_MINUTES=180

# Set to 1 to report findings without blocking completion. The findings are
# still surfaced; the Stop is allowed through.
# An INVALID value falls back to 1 (advisory), not to 0: falling back to the
# blocking default would widen what a malformed setting blocks on.
# Default: 0
TEST_COMPLETION_ADVISORY_ONLY=0

# Set to 1 to require a durable .ai/ note after ANY guarded run, not only after
# a hang, timeout, kill, or unexpectedly slow run.
# Default: 0
TEST_COMPLETION_ALWAYS_REQUIRE_NOTE=0

# Seconds to wait for a same-Stop race with Test-Temp-Cleanup before deferring
# to the next event. Never a retry loop - it defers once and stays silent.
# Capped at 30; a value above ~15 would need the hook's own timeout raised.
# Default: 2
TEST_COMPLETION_COORDINATION_WAIT_SECONDS=2
