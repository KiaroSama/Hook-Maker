# Feature-Request-Check - optional configuration. Copy to `.env` beside the
# installed hook to override; the value below is the default.

# How much of the session transcript the Stop half will read, in bytes. It is
# read from the START (the feature prompt and the grilling call are both early),
# so a transcript larger than this is reported as PARTIAL and the hook then
# stays silent rather than blocking on half a session. Values below 100000 are
# ignored. Raise it only if a real session is being truncated.
MAX_TRANSCRIPT_BYTES=20000000
