# Github-Baseline-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Runs before work starts.
# Manual CI on every host: workflow_dispatch root, reachable local workflow_call
# children; automatic/disabled/unknown routes never establish compliant CI.
# Bounded heuristic: <=50 files, <=256 KiB each; no YAML/expression execution.
# README setup/logo/privacy guidance is advisory, not approval or visual proof.
EVENTS=SessionStart

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Minimum minutes before repeating UNCHANGED findings per repo.
# Changed findings (new gap, fixed gap) report immediately.
# Accepted range 0-10080; anything else keeps the default.
COOLDOWN_MINUTES=240
