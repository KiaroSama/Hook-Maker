# Test-Temp-Cleanup configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Runs before work starts and after
# each task; SubagentStop is opt-in (see ENABLE_SUBAGENT_STOP below).
EVENTS=SessionStart,Stop

# Which client(s) to install for from the Hook Maker menu: Both, Claude, or Codex.
CLIENTS=Both

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Master switch for auto-deleting high-confidence safe candidates.
AUTO_DELETE_SAFE=true

# Diagnostic/review artifacts (coverage, test-results, screenshots, ...) are
# preserved by default. Set true to allow deleting them too, once all hard
# protections (contained, non-linked, untracked/ignored) still pass.
DELETE_REVIEW_ARTIFACTS=false

# Delete safe named caches that already existed before this session started,
# not only ones created during the task. Never applies to __pycache__/*.pyc,
# which must always be genuinely created this session regardless of this flag.
DELETE_PREEXISTING_SAFE_CACHES=true

# Extra literal directory/file leaf NAMES (no path separators, no "..", no
# drive letters, no environment variables) - semicolon separated. Config can
# never override the hard exclusions (never delete tracked/staged/reparse
# points/.git/.ai/.claude/.codex/dependency or build roots by name).
EXTRA_SAFE_PATTERNS=
EXTRA_REVIEW_PATTERNS=

# Conservative limits - cleanup stops and reports "incomplete" once reached.
MAX_DELETE_PATHS=200
MAX_DELETE_BYTES=524288000
MAX_FINDINGS=20

# Off by default: SubagentStop cleanup for sub-agent workspaces.
ENABLE_SUBAGENT_STOP=false
