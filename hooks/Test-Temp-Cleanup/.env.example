# Test-Temp-Cleanup configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.
#
# This hook is a DETECTOR + ADVISOR + COMPLETION GATE. It NEVER deletes, moves,
# renames, or otherwise mutates any project file - there is no setting that can
# turn deletion on, because the feature does not exist. It reports recognized
# candidates with bounded metadata and the agent decides. Nothing below can mark
# a path safe to delete or weaken a protection.

# Events to register on (comma separated). SessionStart records a silent
# metadata-only baseline; Stop rescans, classifies, and gates completion.
# SubagentStop is opt-in (see ENABLE_SUBAGENT_STOP below).
EVENTS=SessionStart,Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Both, Claude, or Codex.
CLIENTS=Both

# Filesystem entries the bounded scan may examine (1..1000000; default 5000).
# Reaching it makes the result PARTIAL with the named cause
# "max-scan-entries-reached" - a partial scan is NEVER reported as clean.
MAX_SCAN_ENTRIES=5000

# Directory depth the scan may descend (1..64; default 8). A directory left
# undescended because of this ceiling adds the named cause
# "max-scan-depth-reached" and makes the result PARTIAL.
MAX_SCAN_DEPTH=8

# How many candidate lines the report may list (1..1000; default 20). Truncates
# the LIST only; the scan and the recorded counts still cover everything seen.
MAX_FINDINGS=20

# Off by default: also evaluate on SubagentStop for sub-agent workspaces.
ENABLE_SUBAGENT_STOP=false

# Extra literal directory/file leaf NAMES to DETECT (no path separators, no
# "..", no drive letters, no environment variables) - semicolon separated.
# These are detection hints ONLY. They cannot mark a path safe to delete and
# cannot override any hard protection (the hard-prune set - .git, .ai, .claude,
# .codex, .kiro, dependency and build roots - plus tracked/staged paths,
# reparse points, and anything outside the project root).
EXTRA_CANDIDATE_NAMES=

# Same rules, but detected as review-only/diagnostic instead of disposable.
EXTRA_REVIEW_NAMES=
