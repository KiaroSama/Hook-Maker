# Ignore-Rules-Check configuration. Copy to ".env" and edit if needed.
EVENTS=SessionStart,Stop
TARGET_PROJECTS=
CLIENTS=Both

# Optional extra gitignore patterns, separated by semicolons.
EXTRA_PATTERNS=

# Ignore patterns found in the project's rule files (AGENTS.md, CLAUDE.md,
# .claude/.codex/.agents/.cursor/.cline rules) on lines about gitignore / local-only /
# do not commit: advisory = only reported (default); write = added to .gitignore
# but never push-blocked; write-and-protect = added and protected (earlier behaviour).
RULE_FILE_PATTERNS=advisory
