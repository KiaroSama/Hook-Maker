# LargeFileCheck configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated).
# SessionStart = pre-task size-policy reminder; Stop = post-task oversized-file scan.
EVENTS=SessionStart,Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Lines above which a source file is reported after a task.
LINE_THRESHOLD=800

# Source extensions to scan (comma separated).
EXTENSIONS=.ps1,.psm1,.py,.js,.ts,.jsx,.tsx,.mjs,.cjs,.cs,.java,.go,.rb,.php,.rs,.c,.cpp,.h,.kt,.swift,.vue,.svelte

# Minimum minutes between Stop reports per project.
COOLDOWN_MINUTES=60
