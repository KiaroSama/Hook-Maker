# Skills-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Inventory of the three installed
# skill sources on SessionStart, prompt-matched shortlist (installed + library
# imports) on UserPromptSubmit, "Skills used:" verification on Stop/SubagentStop.
EVENTS=SessionStart,UserPromptSubmit,Stop,SubagentStop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# The skill library location. There is NO built-in default: set this, or the
# AI_SKILLS_DIR environment variable, or the library half of this hook stays
# silent. (Was an override for the AI_SKILLS_DIR
# environment variable, else the machine default from the Skill Policy).
SKILLS_DIR=

# Optional override for the client's GLOBAL skills directory. When empty it is
# derived from the detected client: <home>\.claude\skills for Claude,
# <home>\.agents\skills for Codex (client is detected via CLAUDE_PROJECT_DIR,
# which Claude Code exports and Codex does not).
GLOBAL_SKILLS_DIR=

# Optional EXTRA plugin cache walk. When empty (the default) plugin skills come
# only from the client's install records (below). When set, every
# <root>\<marketplace>\<plugin>\<version>\skills\<skill> is also reported as
# "<plugin>:<skill>".
PLUGIN_SKILLS_ROOT=

# Per-skill discovery reads what the ACTIVE client really loads. Every path has
# a default; set one only to point at an unusual install.
# Claude: installed_plugins.json (default <home>\.claude\plugins\installed_plugins.json),
# the settings files holding enabledPlugins (semicolon separated; default the
# user, project and project-local settings.json), and the Desktop skill root
# (default %APPDATA%\Claude\local-agent-mode-sessions\skills-plugin).
CLAUDE_PLUGINS_FILE=
CLAUDE_SETTINGS_FILES=
CLAUDE_DESKTOP_SKILLS_ROOT=
# Codex: its home (default CODEX_HOME, else <home>\.codex; config.toml,
# plugins\cache and skills are read inside it) and the shared agent skills
# folder (default SharedAgentSkills\skills beside the resolved Codex home).
CODEX_HOME_DIR=
CODEX_SHARED_SKILLS_DIR=

# Where the deployed routing rules live, for the catalogue-drift advisory
# (global-skill-routing.md, global-skills-catalogue.md, catalogue\plugins-*.jsonl).
# Default: <home>\.claude\rules for Claude, <Codex home>\rules for Codex.
SKILL_RULES_DIR=

# How long the cached index of the two expensive sources - the discovered plugin
# skills and the shared library - stays valid, in minutes. Default 1440 (one
# day); 0 disables expiry (the index is still rebuilt when the configured paths
# or the client's install records change).
# Rebuilding costs roughly two seconds of directory traversal, which is why it
# is not done on every prompt.
LIBRARY_INDEX_TTL_MINUTES=1440

# What happens at Stop when the session transcript shows a skill was actually
# INVOKED and the summary carries no "Skills used:" line:
#   block     (default) refuse the stop once, with the exact line to add.
#   advisory  report the same thing without blocking.
#   off       skip the closing check entirely (the pre-task halves still run).
# A session where no skill was invoked is always advisory, never a block: the
# hook cannot prove a skill was needed.
SKILLS_SUMMARY_ENFORCEMENT=block
