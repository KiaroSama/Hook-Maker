# Skills-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Inventory of the three installed
# skill sources on SessionStart, prompt-matched shortlist (installed + library
# imports) on UserPromptSubmit, "Skills used:" verification on Stop/SubagentStop.
EVENTS=SessionStart,UserPromptSubmit,Stop,SubagentStop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex, Kiro,
# or All. Legacy: Both = Claude + Codex only.
CLIENTS=Both

# Optional override for the skill library location (else the AI_SKILLS_DIR
# environment variable, else the machine default from the Skill Policy).
SKILLS_DIR=

# Optional override for the client's GLOBAL skills directory. When empty it is
# derived from the detected client: <home>\.claude\skills for Claude,
# <home>\.agents\skills for Codex (client is detected via CLAUDE_PROJECT_DIR,
# which Claude Code exports and Codex does not).
GLOBAL_SKILLS_DIR=

# Optional override for the PLUGIN skill cache root. When empty it is
# <home>\.claude\plugins\cache for Claude and non-Codex clients, and unset for
# Codex (which documents no plugin cache). Skills found under
# <root>\<marketplace>\<plugin>\<version>\skills\<skill> are reported as
# "<plugin>:<skill>", the form the client addresses them by.
PLUGIN_SKILLS_ROOT=

# How long the cached index of the two expensive sources - the plugin cache and
# the shared library - stays valid, in minutes. Default 1440 (one day); 0
# disables expiry (the index is still rebuilt when the configured paths change).
# Rebuilding costs roughly two seconds of directory traversal, which is why it
# is not done on every prompt.
LIBRARY_INDEX_TTL_MINUTES=1440

# What happens at Stop when the session transcript shows a skill was actually
# INVOKED and the summary carries no "Skills used:" line:
#   block     (default) refuse the stop once, with the exact line to add.
#   advisory  report the same thing without blocking.
#   off       skip the closing check entirely (the pre-task halves still run).
# A session where no skill was invoked is always advisory, never a block: the
# hook cannot prove a skill was needed.
SKILLS_SUMMARY_ENFORCEMENT=block
