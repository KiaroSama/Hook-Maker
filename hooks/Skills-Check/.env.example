# Skills-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Discovery on SessionStart,
# task-relevance nudge on UserPromptSubmit, "Skills used:" summary requirement
# on Stop.
EVENTS=SessionStart,UserPromptSubmit,Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Both, Claude, or Codex.
CLIENTS=Both

# Optional override for the skill library location (else the AI_SKILLS_DIR
# environment variable, else the machine default from the Skill Policy).
SKILLS_DIR=
