# Git-Sync-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). SessionStart also captures the
# task's baseline (which branches/worktrees already existed). Stop and
# SubagentStop = after each (sub)task: gives the agent a mandatory operational
# instruction to reconcile the repository, and any task-scoped branch or
# worktree, unless doing so is unsafe.
EVENTS=SessionStart,Stop,SubagentStop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
# Example: TARGET_PROJECTS=G:\Projects\Bot A;G:\Projects\Bot B
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex, Kiro,
# or All. Legacy: Both = Claude + Codex only.
CLIENTS=Both

# No cooldown-minutes setting: repeat behavior is fingerprint+session based
# (see the header comment in Git-Sync-Check.ps1), not time-based.
