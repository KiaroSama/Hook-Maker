# Install-Location-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.
#
# PreToolUse advisory: an install command (winget, choco, scoop, pip, npm -g,
# pnpm -g, yarn global, pipx, uv tool/python, cargo, go, dotnet tool -g,
# Install-Module, msiexec or a setup exe incl. the CUDA and Python installers,
# direct or via Start-Process, explorer.exe or Invoke-CimMethod, hf download,
# ollama pull) whose target,
# with junctions and symbolic links followed, is on the system drive gets one
# line asking the agent to get the user's install path first. Never blocks,
# never approves, never rewrites the command. Once per package per session.

# Events to register on (comma separated).
EVENTS=PreToolUse

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Seconds allowed for each read-only query that resolves a target
# (`npm config get prefix`, `python -c "import sys; print(sys.prefix)"`).
# Answers are cached per session. 1..8; anything else falls back to 5.
QUERY_TIMEOUT_SECONDS=5
