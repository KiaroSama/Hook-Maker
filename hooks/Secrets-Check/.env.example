# Secrets-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.
#
# WHICH .env: the one BESIDE THE HOOK SCRIPT - for an installed hook that is
#   <project>\.claude\hooks\Hook-Maker\Secrets-Check\.env
# Native pre-push has its OWN settings beside its script:
#   <project>\.git\hooks\Hook-Maker\Secrets-Check\.env
# Configure each installed runtime that should use the same exact public keys.
# NOT the project's own .env at the repository root. The project's .env is the
# file this hook SCANS; settings placed there have no effect (and letting the
# scanned file classify its own keys would defeat the leak guard). Installs and
# updates never overwrite or delete this file, so edits here survive upgrades.

# Events to register on (comma separated).
# SessionStart = pre-task report; Stop = post-task check (also auto-appends).
EVENTS=SessionStart,Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Minutes between repeated non-critical reports per project (a live leak, an
# untracked-when-it-shouldn't-be secrets.md, etc. always bypass this).
# Accepted range 0-10080; anything else keeps the default.
COOLDOWN_MINUTES=60

# Minutes between the heavier "is this secret still referenced anywhere in the
# project" scan. Deliberately infrequent - default 10080 = 7 days.
# Accepted range 0-100000; anything else keeps the default.
UNUSED_SCAN_COOLDOWN_MINUTES=10080

# Auto-write secrets found in real root or nested .env* files but missing from secrets.md (true/false).
# The value is copied file-to-file only - never printed, logged, or echoed.
# Template/dependency/build/cache/assistant-runtime trees are excluded.
AUTO_APPEND=true

# Values shorter than this are skipped by the leak scan (avoids noisy false
# positives on trivial values like "true" or "1").
# Accepted range 4-4096; anything else keeps the default.
MIN_SECRET_LENGTH=8

# Explicit local classification overrides for ambiguous keys (comma separated
# exact KEY names, or KEY_PREFIX* for a narrow prefix match). Never store
# values here - names only. These two keys are read from THIS file only (see
# "WHICH .env" at the top) - putting them in the scanned project .env does
# nothing. The "Classification unclear" advisory prints the full path to use.
#
# Precedence (strongest first, never reorderable by config):
#   SECRET_KEYS > definite credential value/key evidence > PUBLIC_CONFIG_KEYS >
#   entropy heuristic > inferred public config (public-looking key AND a
#   recognized public value shape) > Unknown.
# PUBLIC_CONFIG_KEYS can correct an Unknown or entropy-only guess for a VERIFIED
# public identifier (e.g. an exact MODEL_1_ID), never a definite credential.
# Prefer exact keys; never exempt all MODEL_* fields. Most keys need no override:
# strong credential evidence
# (key semantics like TOKEN/SECRET/PASSWORD, or a credential-shaped value)
# still classifies as Secret even under a NEXT_PUBLIC_/PUBLIC_/VITE_/REACT_APP_
# prefix, and obvious public config (NEXT_PUBLIC_APP_URL, R2_BUCKET, ...) is
# already recognized without any override.
SECRET_KEYS=
# Mixed-case entropy uses case-sensitive character checks; custom model IDs
# are not automatically public. Add only verified exact keys, never MODEL_*.
PUBLIC_CONFIG_KEYS=
