# Secrets-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated).
# SessionStart = pre-task report; Stop = post-task check (also auto-appends).
EVENTS=SessionStart,Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Both, Claude, or Codex.
CLIENTS=Both

# Minutes between repeated non-critical reports per project (a live leak, an
# untracked-when-it-shouldn't-be secrets.md, etc. always bypass this).
COOLDOWN_MINUTES=60

# Minutes between the heavier "is this secret still referenced anywhere in the
# project" scan. Deliberately infrequent - default 10080 = 7 days.
UNUSED_SCAN_COOLDOWN_MINUTES=10080

# Auto-write secrets found in real root or nested .env* files but missing from secrets.md (true/false).
# The value is copied file-to-file only - never printed, logged, or echoed.
# Template/dependency/build/cache/assistant-runtime trees are excluded.
AUTO_APPEND=true

# Values shorter than this are skipped by the leak scan (avoids noisy false
# positives on trivial values like "true" or "1").
MIN_SECRET_LENGTH=8

# Explicit local classification overrides for ambiguous keys (comma separated
# exact KEY names, or KEY_PREFIX* for a narrow prefix match). Never store
# values here - names only.
#
# Precedence (strongest first, never reorderable by config):
#   SECRET_KEYS > credential-like value/key evidence > PUBLIC_CONFIG_KEYS >
#   inferred public config (public-looking key AND a recognized public value
#   shape) > Unknown.
# PUBLIC_CONFIG_KEYS can NEVER declassify a real credential - it only ever
# converts a genuinely Unknown, non-credential-like key/value into
# PublicConfig. Most keys never need an override: strong credential evidence
# (key semantics like TOKEN/SECRET/PASSWORD, or a credential-shaped value)
# still classifies as Secret even under a NEXT_PUBLIC_/PUBLIC_/VITE_/REACT_APP_
# prefix, and obvious public config (NEXT_PUBLIC_APP_URL, R2_BUCKET, ...) is
# already recognized without any override.
SECRET_KEYS=
PUBLIC_CONFIG_KEYS=
