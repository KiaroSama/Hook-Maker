# Writing-Voice-Check - optional configuration. Copy to `.env` beside the
# installed hook to override; every value below is the default.

# One note per session and language (UserPromptSubmit) naming the voice skill
# for the language the user typed. 1 = on (default), 0 = off. SessionStart and
# Stop are unaffected.
PROMPT_REMINDER=1

# Complete-transcript size the Stop gate reads (bytes, minimum 100000). A
# larger transcript is unknown evidence: the gate stays silent, never refuses.
MAX_TRANSCRIPT_BYTES=20000000
