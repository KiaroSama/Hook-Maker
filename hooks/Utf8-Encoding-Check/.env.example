# Utf8-Encoding-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.
#
# Every value below is optional; the defaults are conservative and the hook
# stays silent when nothing is actionable. An invalid integer is reported
# once, in plain text, and the documented default is used - a malformed
# setting must never crash a session. An invalid UTF8_ADVISORY_ONLY value
# falls back to advisory-only (true), the non-widening fallback: a typo must
# never make this hook block on MORE than intended.

# Events to register on (comma separated). SessionStart takes a bounded
# METADATA-ONLY baseline of the project's text files (relative path, size,
# mtime, classification - never contents) and reports pre-existing non-UTF-8
# text as a one-time advisory, never a block. Stop (and SubagentStop, which
# behaves identically) inspects only the text files created or modified
# during the task and BLOCKS on new/changed invalid UTF-8 that is not covered
# by a documented exception. The native pre-push mode (-GitPrePush) is wired
# by the installer's git pre-push chain, not by a lifecycle event.
EVENTS=SessionStart,Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
# Example: TARGET_PROJECTS=G:\Projects\Bot A;G:\Projects\Bot B
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# --- scan ceilings ---------------------------------------------------------
# Every scan is bounded on every dimension. When any ceiling (or an
# unreadable file/directory) stops a scan early, the output says the coverage
# was PARTIAL instead of implying the whole project was covered; at pre-push
# a ceiling overflow of REQUIRED coverage FAILS CLOSED (blocks the push)
# rather than passing an unscanned range.

# Maximum files classified per scan. Also bounds the changed-file check at
# Stop and the outgoing text blobs validated per push. Range 1..100000.
# Default: 400
UTF8_MAX_FILES=400

# Maximum KB read from any single file or blob. A larger TEXT-looking file is
# 'oversized' (unknown - honestly reported; fail-closed at pre-push); a larger
# binary-looking file is skipped as binary. Range 1..1048576.
# Default: 1024
UTF8_MAX_FILE_KB=1024

# Maximum directories the baseline walk may visit before stopping (partial).
# Range 1..1000000.
# Default: 4000
UTF8_MAX_DIRECTORIES=4000

# Maximum total wall-clock seconds for one scan before stopping (partial).
# Range 1..3600.
# Default: 10
UTF8_MAX_SCAN_SECONDS=10

# Maximum findings shown in one report before capping with an omitted count.
# Range 1..1000.
# Default: 8
UTF8_MAX_FINDINGS=8

# Project-relative path of the optional exception registry (never
# auto-created; must stay physically inside the project). Schema:
#   { "version": 1, "exceptions": [ { "path": "docs/legacy.txt",
#     "encoding": "windows-1252", "reason": "vendor export kept byte-identical",
#     "verification": "reviewed 2026-07-01" } ] }
# Recognized encoding labels: utf-16le, utf-16be, windows-1252, iso-8859-1,
# latin-1, shift_jis, euc-jp, gb18030. There is deliberately no 'binary'
# label - an exception can never reclassify binary as text. A malformed or
# overly broad entry is rejected with a warning and never grants an exception.
# Default: .utf8-encoding-exceptions.json
UTF8_EXCEPTION_FILE=

# true = never block: every would-be Stop block becomes a client-aware
# advisory (the pre-push mode still fails closed on unscannable REQUIRED
# coverage, but confirmed findings are reported without exit 1).
# Default: false
UTF8_ADVISORY_ONLY=false
