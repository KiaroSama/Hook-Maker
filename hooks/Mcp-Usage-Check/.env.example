# Mcp-Usage-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Policy + closing requirement on
# SessionStart; task-relevance reminder on UserPromptSubmit (silent unless the
# prompt suggests MCP tools would help); verification of the "MCP used:" summary
# line on Stop/SubagentStop.
EVENTS=SessionStart,UserPromptSubmit,Stop,SubagentStop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex, Kiro,
# or All. Legacy: Both = Claude + Codex only.
CLIENTS=Both

# What happens at Stop when the session DID call MCP server tools and the final
# summary carries no "MCP used:" line:
#   block     (default) refuse the stop once, naming the servers observed and the
#             exact line to add. Only ever fires on that confirmed condition.
#   advisory  report the same thing without blocking.
#   off       skip the closing check entirely (the pre-task halves still run).
# A session where NO MCP tool was called is always advisory, never a block: the
# hook cannot prove a tool was needed.
MCP_SUMMARY_ENFORCEMENT=block
