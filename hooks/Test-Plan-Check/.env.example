# Test-Plan-Check - before-the-work test-health advisory.
#
# Copy to .env next to this file and edit. Every value below is optional; the
# defaults are conservative and the hook stays silent when nothing is relevant.
# An invalid value is reported once, in plain text, and the default is used -
# a malformed setting must never make the hook block or crash a session.

# Minutes before the same unchanged finding may be reported again in one
# project. Keeps a stable repository from re-warning on every prompt.
# Default: 120
TEST_PLAN_COOLDOWN_MINUTES=120

# Comma-separated extra keywords that make a prompt "test related" for THIS
# project, on top of the built-in set (test, ci, runner, hang, timeout,
# parallel, worker, cpu, memory, sleep, poll, cleanup, flaky, coverage).
# Use it for project-specific vocabulary, e.g. pytest,vitest,nunit.
# Default: empty
TEST_PLAN_EXTRA_KEYWORDS=

# Set to 1 to report on every relevant prompt instead of honouring the cooldown.
# Intended for debugging the hook itself.
# Default: 0
TEST_PLAN_ALWAYS_REPORT=0
