# Test-Plan-Check - before-the-work test-health advisory.
#
# Copy to .env next to this file and edit. Every value below is optional; the
# defaults are conservative and the hook stays silent when nothing is relevant.
# An invalid value is reported once, in plain text, and the default is used -
# a malformed setting must never make the hook block or crash a session.

# Minutes before the same unchanged finding may be reported again in one
# project. Keeps a stable repository from re-warning on every prompt.
# Default: 120
TEST_PLAN_COOLDOWN_MINUTES=120

# Comma-separated extra keywords that make a prompt "test related" for THIS
# project, on top of the built-in set (test, ci, runner, hang, timeout,
# parallel, worker, cpu, memory, sleep, poll, cleanup, flaky, coverage).
# Use it for project-specific vocabulary, e.g. pytest,vitest,nunit.
# Default: empty
TEST_PLAN_EXTRA_KEYWORDS=

# Set to 1 to report on every relevant prompt instead of honouring the cooldown.
# Intended for debugging the hook itself.
# Default: 0
TEST_PLAN_ALWAYS_REPORT=0

# --- scan ceilings ---------------------------------------------------------
# The risk scan is an iterative directory walk that PRUNES excluded trees
# (.git, node_modules, .venv, dist/build, graphify-out, .ai, .claude, ...) and
# never follows a junction/symlink. Each ceiling below bounds one dimension of
# the walk; an invalid value is reported once and the default is used. When any
# ceiling (or an unreadable directory) stops the scan early, the advisory says
# the scan was PARTIAL rather than implying the whole repository was covered.

# Maximum directories the walk may visit before stopping (partial). Range 1..1000000.
# Default: 4000
TEST_PLAN_MAX_DIRS=4000

# Maximum candidate test files inspected before stopping (partial). Range 1..100000.
# Default: 200
TEST_PLAN_MAX_FILES=200

# Maximum KB read from any single file (larger files are skipped and coverage
# is marked partial). Range 1..1048576.
# Default: 400
TEST_PLAN_MAX_FILE_KB=400

# Maximum total wall-clock seconds for the whole scan before stopping (partial). Range 1..3600.
# Default: 5
TEST_PLAN_MAX_SCAN_SECONDS=5

# Maximum findings emitted before the scan stops (partial). Range 1..1000.
# Default: 8
TEST_PLAN_MAX_FINDINGS=8

# --- blind-wait detection -------------------------------------------------
# A FIXED literal sleep of at least this many seconds inside a test file is
# reported as a blind wait, with its file:line. Set to 0 to disable the check.
# This deliberately MIRRORS TEST_GUARD_MAX_BLIND_SLEEP_SECONDS in Test-Run-Guard,
# same default and same 0-disables meaning, so the before-stage and the
# during-stage agree on what a blind sleep is. When they disagreed (60 here,
# 30 there) a 45-second sleep passed this stage in silence and was then denied
# outright at the moment the run started. Change one, change the other.
# A short bounded backoff inside a deadline loop stays below it and is never
# touched. Range 0..86400.
# Default: 30
TEST_PLAN_MAX_BLIND_SLEEP_SECONDS=30
