# Rules-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Lists the governing rules before work
# starts (SessionStart, UserPromptSubmit) and verifies the "Rules applied:"
# confirmation after it (Stop, SubagentStop).
EVENTS=SessionStart,UserPromptSubmit,Stop,SubagentStop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Optional override for the GLOBAL rules directory. Default: <home>\.claude\rules
# when running under Claude, <home>\.codex\rules when running under Codex.
# The project-local rules directory (<project>\.claude\rules / <project>\.codex\rules)
# is always checked and cannot be overridden.
GLOBAL_RULES_DIR=

# What happens at Stop when rule files exist, the session transcript shows this
# session EDITED files, and the summary carries no "Rules applied:" line:
#   block     (default) refuse the stop once, listing the governing rule files
#             and the exact line to add.
#   advisory  report the same thing without blocking.
#   off       skip the closing check entirely (the pre-task halves still run).
# A session with no observed file edits, or one whose transcript this hook
# cannot read, is always advisory - never a block.
RULES_CONFIRMATION_ENFORCEMENT=block
