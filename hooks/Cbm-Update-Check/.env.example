# Cbm-Update-Check - optional configuration. Copy to `.env` beside the
# installed hook to override; every value below is the default.

# Where Codebase Memory MCP keeps its per-project databases. Blank = the
# CBM_CACHE_DIR environment variable, then the CBM_CACHE_DIR recorded in the MCP
# server's own "env" block in the client config, then the binary's default.
# That third step usually decides it: the variable is normally set only inside
# that server record, so the server has it and a hook process never does.
CBM_CACHE_DIR=

# How far the index may lag behind the newest code work before this is worth
# reporting. This is the background watcher's expected catch-up time, not a
# patience setting: below it the watcher simply has not caught up yet.
STALE_MINUTES=10

# Minimum minutes between two reports for the same project.
COOLDOWN_MINUTES=60
