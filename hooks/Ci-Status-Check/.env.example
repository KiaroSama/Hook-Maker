# Ci-Status-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Runs when a task tries to finish.
EVENTS=Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Minutes between full "checks still running" reports for the same commit.
# Completion remains blocked during this cooldown; only repeated detail is reduced.
PENDING_COOLDOWN_MINUTES=3

# Minutes between full reports for the same already-reported failed commit.
# Completion remains blocked until a replacement commit or explicit external blocker.
FAILURE_COOLDOWN_MINUTES=30

# Minutes an explicit -ReportExternalBlocker exception stays valid before it
# expires and normal (blocking) evaluation resumes. Local-only; never marks a
# commit verified/green.
EXTERNAL_BLOCKER_TTL_MINUTES=1440

# Minutes between re-verifying an active external-blocker exception's exact-SHA
# CI state. CI turning green retires the exception (verified normally); CI
# changing to a different state (including a real failure) invalidates it.
# While the exception is active, Stop emits a NON-BLOCKING "CI NOT VERIFIED
# GREEN" notice so completion context cannot misrepresent CI as successful.
EXTERNAL_BLOCKER_RECHECK_MINUTES=15
