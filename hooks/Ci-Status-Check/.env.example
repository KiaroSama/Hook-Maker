# Ci-Status-Check configuration.
# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored.

# Events to register on (comma separated). Runs when a task tries to finish.
# All hosts: bounded manual workflow_dispatch root / reachable workflow_call
# validation with no run is pending final dispatch, never assumed automatic/green.
# Raw exact repo/SHA/workflow/event/attempt/jobs/steps/checks are required for green.
# Auxiliary success and legacy cache labels never authorize CI success. Versioned
# receipts are fresh for 60 minutes; recovery uses actual CI completion time.
# Unsupported workload expansion needs a reviewed source-bound project policy.
# Reviewed inapplicable jobs use disposition=skipped, a substantive rationale and
# explicit steps=[]; only their exact-attempt correlated check IDs may be skipped.
# Required work still succeeds; skipped jobs never supply execution freshness.
# Pending cache refreshes exact-source evidence first; unproven is not running.
# External-blocker and owned-runner checks retain their separate contracts.
EVENTS=Stop

# Project roots for config-based install from the Hook Maker menu (semicolon separated).
TARGET_PROJECTS=

# Which client(s) to install for from the Hook Maker menu: Claude, Codex,
# or All. Legacy: Both = Claude + Codex.
CLIENTS=Both

# Legacy pending-detail interval, retained for configuration compatibility.
# Fresh exact-source evidence always precedes pending reporting; unchanged blocks
# are suppressed by the existing session/evidence fingerprint, never cached green.
# Accepted range 0-10080; anything else keeps the default.
PENDING_COOLDOWN_MINUTES=3

# Minutes between full reports for the same already-reported failed commit.
# Completion remains blocked until a replacement commit or explicit external blocker.
# Accepted range 0-10080; anything else keeps the default.
FAILURE_COOLDOWN_MINUTES=30

# Minutes an explicit -ReportExternalBlocker exception stays valid before it
# expires and normal (blocking) evaluation resumes. Local-only; never marks a
# commit verified/green.
# Accepted range 0-10080; anything else keeps the default.
EXTERNAL_BLOCKER_TTL_MINUTES=1440

# Minutes between re-verifying an active external-blocker exception's exact-SHA
# CI state. CI turning green retires the exception (verified normally); CI
# changing to a different state (including a real failure) invalidates it.
# While the exception is active, Stop emits a NON-BLOCKING "CI NOT VERIFIED
# GREEN" notice so completion context cannot misrepresent CI as successful.
# Accepted range 0-1440; anything else keeps the default.
EXTERNAL_BLOCKER_RECHECK_MINUTES=15

# Total seconds this hook may spend talking to GitHub per run (every gh call
# shares it; gh auth status is asked once per session). Keep it at least 15 s
# below the hook's registered timeout. Out of budget = "could not verify", never green.
GH_BUDGET_SECONDS=40
# Read-only metadata batch: max 4 concurrent requests, 32 unique endpoints,
# 1 MiB per response / 4 MiB total, including errors, within this same budget.
# Successful immutable discovery is reused only within this invocation.

# Docs-only carryover: repository size alone is not a refusal. All-directory
# reader/reference discovery is bounded to 100 candidates and 1 MiB consumer
# text; Git queries share this deadline, at most 5 s / 1 MiB each, one worker.
# Unknown/semantic input scope stays blocked with its actual reason, never a
# wait for a skipped final-SHA run. These safety bounds are not bypass settings.
# Known complete Cargo.lock v3/v4 data is not executable reader source; unknown
# forms/literal docs references/actual consumers remain unproven. Ancestor manual
# workflow_dispatch evidence must match exact SHA/repository/branch/workflow path.
# Exact reviewed input closure may use .hookmaker-docs-policy.json; it binds the
# whole tree, document blobs and complete bounded candidate inventory/roles.
# Runtime _docs-policy.json schema2 instead binds immutable baseline/ancestor,
# all non-document mode/blob/byte/path inventory and explicit branch/prose scope.
# Runtime _ci-policy.json schema2 uses the same reviewed closure for workloads.
# These reviews require source evidence and are never generated automatically.
# No saved CI result or generic reader/UTF8/branch waiver is accepted. Carryover
# notices use versioned source provenance; stale records never skip revalidation.
