{
  "version": 2,
  "defaults": {
    "events": [
      "SessionStart",
      "UserPromptSubmit"
    ],
    "initialSyncMode": "review",
    "maxFileBytes": 2097152,
    "includeExtensions": [
      ".md"
    ],
    "excludePatterns": [
      ".cross-project-sync/*",
      "*/.cross-project-sync/*",
      ".git/*",
      "*/.git/*",
      "node_modules/*",
      "*/node_modules/*",
      "logs/*",
      "*/logs/*",
      "cache/*",
      "*/cache/*",
      "tmp/*",
      "*/tmp/*",
      "temp/*",
      "*/temp/*",
      "graph/*",
      "*/graph/*",
      "indexes/*",
      "*/indexes/*",
      "artifacts/*",
      "*/artifacts/*",
      "*.log",
      "*.tmp",
      "*.bak",
      ".env",
      ".env.*",
      "*/.env",
      "*/.env.*",
      "secrets.*",
      "*/secrets.*",
      "*credentials*.json",
      "*credential*.json",
      "*tokens*.json",
      "*token*.json",
      "Thumbs.db",
      "*/Thumbs.db",
      ".DS_Store",
      "*/.DS_Store"
    ],
    "reviewInstructions": [
      "Keep destination rules and project facts authoritative. Deduplicate generalized lessons before adding them."
    ]
  },
  "profiles": []
}
