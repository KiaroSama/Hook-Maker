graphify-out/
.ignoreme
**/.ignoreme

# Runtime sync state (created inside each destination project's .ai directory)
.cross-project-sync/

# Runtime logs and config backups
logs/
*.log
*.backup-*

# Local hook configuration (each hook's .env.example stays tracked)
.env

# The real routing config is machine-local (it holds your project paths).
# It is auto-created from sync-hooks.example.json on first wizard run.
/sync-hooks.json

# Machine-local install registry/history (which hooks Hook Maker has
# installed and where) - used by "Update previously installed hooks".
/state/

# Hook Maker: local/private files (auto-managed)
/graphify-out/
# Project-owned test/CI working data (global-environment-rules.md): every
# Windows test artifact lives inside its owning project root rather than the
# machine's shared temp, so the path is generated and never tracked.
/.ci-work/
/.env
/.env.*
!/.env.example
!/.env.sample
!/.env.template
!/.env.dist

# Advisor handoff plans (local working notes, not part of the tool)
/plans/
# Browser-automation scratch written into the repo root by tooling runs.
# Ignored rather than deleted: another session may still be writing them.
/.playwright-mcp/
/real-dark-fa.png

# Local assistant skill state - machine-specific, not part of the tool
/skills-lock.json

# Throwaway hook fixtures the test suites create inside the real hooks\ directory
# and delete again. One survived an aborted run and was committed, which put a
# second "custom hook" in every menu render CI saw.
/hooks/ZZZ-*/

!/.env.example
!/.env.sample
!/.env.template
!/.env.dist
